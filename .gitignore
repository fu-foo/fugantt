/target
*.db
*.db-wal
*.db-shm
# テストが読む固定データ。これだけは持つ
!apps/fugantt/tests/fixtures/v1.db
/crates/fu-gantt-web/web/node_modules

# crates/fu-gantt-web/web/dist is committed on purpose: the Rust build embeds it as an asset, so
# building the server must not require Node.

# macOS がフォルダごとに置いていく表示設定。中身は誰の役にも立たない
.DS_Store

# 各自のローカル設定。名前のとおり共有するものではない
.claude/settings.local.json

# Fly.io に置くなら各自で書く。リポジトリでは持たない
/fly.toml
